# Copy this file to .env and fill in your values

# Google Gemini API key (required for AI generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (optional — enables Llama 3.3 for faster logbook writing)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas connection URI (required for context persistence between months)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
